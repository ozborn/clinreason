format-version: 1.2
data-version: clco/releases/2026-11-20/clco-base.owl
idspace: dc http://purl.org/dc/elements/1.1/ 
idspace: oboInOwl http://www.geneontology.org/formats/oboInOwl# 
idspace: terms http://purl.org/dc/terms/ 
ontology: clco/clco-base
property_value: dc:creator "James J. Cimino" xsd:string
property_value: dc:creator "John D. Osborne" xsd:string
property_value: dc:creator "Tiago K. Colicchio" xsd:string
property_value: dc:description "An ontology for representing clinical reasoning context, including diagnostic workflows, therapeutic decision-making, and the clinician interpretations and decisions that surround patient care but are not well captured by problem-focused EHR systems or terminologies such as SNOMED CT." xsd:string
property_value: dc:title "Clinical Context Ontology" xsd:string
property_value: dc:type IAO:8000001
property_value: owl:versionInfo "2026-11-20" xsd:string
property_value: terms:creator https://orcid.org/0000-0002-0851-1150
property_value: terms:creator https://orcid.org/0000-0003-3405-1538
property_value: terms:creator https://orcid.org/0000-0003-4101-1622
property_value: terms:license http://creativecommons.org/licenses/by/4.0/

[Term]
id: BFO:0000001
name: entity
def: "An entity is anything that exists or has existed or will exist." []
property_value: IAO:0000112 "POSITIVE EXAMPLES: patient, pneumonia, and MRI are entities.\nNEGATIVE EXAMPLES: quickly, because, and was are not entities.\nCONTEXTUAL EXAMPLES: In \"The patient has pneumonia\", patient and pneumonia are entities; in \"The MRI showed a mass\", MRI and mass are entities." xsd:string

[Term]
id: CLCO:0000002
name: is transferred to
def: "Destination of patient transference" []
xref: LOINC:LP203270-6
xref: OMOP_CONCEPT_ID:1014654
is_a: CLCO:0000058 ! has setting
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"transferred to the ICU\" => is transferred to\n\"sent to the rehabilitation unit\" => is transferred to\n\"moved to the operating room\" => is transferred to\n\nNEGATIVE EXAMPLES:\n\"admitted to the ICU\" => is admitted, NOT is transferred to\n\"referred to cardiology\" => is referred by, NOT is transferred to\n\"discharged home\" => is discharged, NOT is transferred to\n\nCONTEXTUAL EXAMPLES:\n\"The patient was transferred to the ICU.\"\nSOURCE: \"patient\" => patient; TARGET: \"ICU\" => setting\nRELATION: SOURCE => is transferred to => TARGET\n\"She was sent to the rehabilitation unit.\"\nSOURCE: \"patient\" => patient; TARGET: \"rehabilitation unit\" => setting\nRELATION: SOURCE => is transferred to => TARGET\n\"He was moved to the operating room.\"\nSOURCE: \"patient\" => patient; TARGET: \"operating room\" => setting\nRELATION: SOURCE => is transferred to => TARGET" xsd:string

[Term]
id: CLCO:0000003
name: clinical administration
def: "A clinical process related to tracking administrative responsibilitity." []
is_a: CLCO:0000057 ! clinical association
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"admitted to the hospital\" => clinical administration\n\"referred to cardiology\" => clinical administration\n\"discharged home\" => clinical administration\n\nNEGATIVE EXAMPLES:\n\"chest pain\" => finding, NOT clinical administration\n\"MRI\" => intervention, NOT clinical administration\n\"recommended surgery\" => clinical decision, NOT clinical administration\n\nCONTEXTUAL EXAMPLES:\n\"The patient was admitted to the hospital.\"\nSOURCE: \"patient\" => patient; TARGET: \"admitted to the hospital\" => clinical administration\nRELATION: SOURCE => clinical administration => TARGET\n\"She was referred to cardiology.\"\nSOURCE: \"patient\" => patient; TARGET: \"referred to cardiology\" => clinical administration\nRELATION: SOURCE => clinical administration => TARGET\n\"He was discharged home.\"\nSOURCE: \"patient\" => patient; TARGET: \"discharged home\" => clinical administration\nRELATION: SOURCE => clinical administration => TARGET" xsd:string
property_value: IAO:0000232 "Do not instantiate." xsd:string

[Term]
id: CLCO:0000005
name: clinical decision
def: "A clinical association representing a decision made during patient care, such as a treatment plan, referral, or diagnostic strategy." []
is_a: CLCO:0000057 ! clinical association
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"decided to start chemotherapy\" => clinical decision\n\"plan for surgical repair\" => clinical decision\n\"decision to order an MRI\" => clinical decision\n\nNEGATIVE EXAMPLES:\n\"chest pain\" => finding, NOT clinical decision\n\"MRI\" => intervention, NOT clinical decision\n\"admitted to the hospital\" => clinical administration, NOT clinical decision\n\nCONTEXTUAL EXAMPLES:\n\"The team decided to start chemotherapy.\"\nSOURCE: \"team\" => clinician; TARGET: \"start chemotherapy\" => intervention\nRELATION: SOURCE => clinical decision => TARGET\n\"The plan was for surgical repair.\"\nSOURCE: \"plan\" => clinical decision; TARGET: \"surgical repair\" => intervention\nRELATION: SOURCE => clinical decision => TARGET\n\"The physician decided to order an MRI.\"\nSOURCE: \"physician\" => clinician; TARGET: \"order an MRI\" => intervention\nRELATION: SOURCE => clinical decision => TARGET" xsd:string

[Term]
id: CLCO:0000006
name: clinical explanation
def: "A clinical reason explaining the reasoning behind a treatment, intervention, condition or medical statement." []
is_a: CLCO:0000057 ! clinical association
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"because of persistent pain\" => clinical explanation\n\"due to concern for infection\" => clinical explanation\n\"to reduce the risk of recurrence\" => clinical explanation\n\nNEGATIVE EXAMPLES:\n\"chest pain\" => finding, NOT clinical explanation\n\"MRI\" => intervention, NOT clinical explanation\n\"physician\" => clinician, NOT clinical explanation\n\nCONTEXTUAL EXAMPLES:\n\"The MRI was ordered because of persistent pain.\"\nSOURCE: \"MRI\" => intervention; TARGET: \"persistent pain\" => reason\nRELATION: SOURCE => clinical explanation => TARGET\n\"Antibiotics were started due to concern for infection.\"\nSOURCE: \"antibiotics\" => intervention; TARGET: \"concern for infection\" => reason\nRELATION: SOURCE => clinical explanation => TARGET\n\"Surgery was performed to reduce the risk of recurrence.\"\nSOURCE: \"surgery\" => intervention; TARGET: \"reduce the risk of recurrence\" => reason\nRELATION: SOURCE => clinical explanation => TARGET" xsd:string

[Term]
id: CLCO:0000007
name: has action
def: "A member of the clinical team has a specific action" []
xref: OMOP_CONCEPT_ID:4044702
xref: SNOMED:129450000
is_a: CLCO:0000003 ! clinical administration
relationship: CLCO:0002502 CLCO:0000108 ! has subject clinician
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"scheduled the procedure\" => has action\n\"uploaded the record\" => has action\n\"called the patient\" => has action\n\nNEGATIVE EXAMPLES:\n\"chest pain\" => finding, NOT has action\n\"MRI\" => intervention, NOT has action\n\"physician\" => clinician, NOT has action\n\nCONTEXTUAL EXAMPLES:\n\"The nurse scheduled the procedure.\"\nSOURCE: \"nurse\" => clinician; TARGET: \"scheduled the procedure\" => task\nRELATION: SOURCE => has action => TARGET\n\"Staff uploaded the record.\"\nSOURCE: \"staff\" => clinician; TARGET: \"uploaded the record\" => task\nRELATION: SOURCE => has action => TARGET\n\"The office staff called the patient.\"\nSOURCE: \"office staff\" => clinician; TARGET: \"called the patient\" => task\nRELATION: SOURCE => has action => TARGET" xsd:string
property_value: IAO:0000112 "upload OSH CT chest pulmonary vein protocol" xsd:string

[Term]
id: CLCO:0000010
name: is admitted
def: "Statement indicating that the patient was admitted to a specific setting" []
is_a: CLCO:0000058 ! has setting
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "Patient admitted to ICU" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"admitted to the hospital\" => is admitted\n\"admitted to the ICU\" => is admitted\n\"admitted for observation\" => is admitted\n\nNEGATIVE EXAMPLES:\n\"transferred to the ICU\" => is transferred to, NOT is admitted\n\"discharged home\" => is discharged, NOT is admitted\n\"referred to cardiology\" => is referred by, NOT is admitted\n\nCONTEXTUAL EXAMPLES:\n\"The patient was admitted to the hospital.\"\nSOURCE: \"patient\" => patient; TARGET: \"hospital\" => setting\nRELATION: SOURCE => is admitted => TARGET\n\"She was admitted to the ICU.\"\nSOURCE: \"patient\" => patient; TARGET: \"ICU\" => setting\nRELATION: SOURCE => is admitted => TARGET\n\"He was admitted for observation.\"\nSOURCE: \"patient\" => patient; TARGET: \"observation\" => setting\nRELATION: SOURCE => is admitted => TARGET" xsd:string
property_value: IAO:0000232 "Does not exist in OMOP, admission is specific for inpatients or other facility types." xsd:string

[Term]
id: CLCO:0000011
name: precedes
def: "Statement indicating that an intervention or finding precedes an intervention or finding." []
xref: OMOP_CONCEPT_ID:4272244
xref: SNOMED:367409002
is_a: CLCO:0000116 ! temporal relation
property_value: IAO:0000112 "Here for packing and splint removal after recent discharge from rehab" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"preceded by\" => precedes\n\"before\" => precedes\n\"followed by\" => precedes\n\nNEGATIVE EXAMPLES:\n\"because of\" => has reason, NOT precedes\n\"caused by\" => is caused by, NOT precedes\n\"recommended\" => recommended, NOT precedes\n\nCONTEXTUAL EXAMPLES:\n\"The biopsy preceded the surgery.\"\nSOURCE: \"biopsy\" => intervention; TARGET: \"surgery\" => intervention\nRELATION: SOURCE => precedes => TARGET\n\"The fever occurred before the rash.\"\nSOURCE: \"fever\" => finding; TARGET: \"rash\" => finding\nRELATION: SOURCE => precedes => TARGET\n\"The follow-up visit followed hospital discharge.\"\nSOURCE: \"hospital discharge\" => intervention; TARGET: \"follow-up visit\" => intervention\nRELATION: SOURCE => precedes => TARGET" xsd:string
property_value: IAO:0000232 "Re-parented from clinical explanation (CLCO:0000006) to temporal relation (CLCO:0000116) on 2026-10-30: precedence is temporal ordering, not explanation. TimeML TLINK relType BEFORE; interval semantics are time:intervalBefore, linked by rdfs:seeAlso. The inverse is follows (CLCO:0000117)." xsd:string
property_value: IAO:0000232 "Used to be \"is followed by\" but this causes confusion when following refers to a particular clilnician responsible for a patient's care" xsd:string
property_value: seeAlso intervalBefore

[Term]
id: CLCO:0000012
name: is performed by
def: "Report of provider performing an intervention or assessment" []
is_a: CLCO:0000003 ! clinical administration
relationship: CLCO:0002501 CLCO:0000108 ! has object clinician
relationship: CLCO:0002502 CLCO:0000102 ! has subject intervention
property_value: IAO:0000112 "A barium swallow was performed by Dr. PHI which was concerning for moderate aspiration.  Additionally, a hard palate lesion was seen." xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"performed by Dr. Smith\" => is performed by\n\"administered by the nurse\" => is performed by\n\"read by the radiologist\" => is performed by\n\nNEGATIVE EXAMPLES:\n\"referred by Dr. Smith\" => is referred by, NOT is performed by\n\"seen by the cardiologist\" => is seen by, NOT is performed by\n\"recommended by the physician\" => recommended, NOT is performed by\n\nCONTEXTUAL EXAMPLES:\n\"The barium swallow was performed by Dr. Smith.\"\nSOURCE: \"barium swallow\" => intervention; TARGET: \"Dr. Smith\" => clinician\nRELATION: SOURCE => is performed by => TARGET\n\"The medication was administered by the nurse.\"\nSOURCE: \"medication\" => intervention; TARGET: \"nurse\" => clinician\nRELATION: SOURCE => is performed by => TARGET\n\"The scan was read by the radiologist.\"\nSOURCE: \"scan\" => intervention; TARGET: \"radiologist\" => clinician\nRELATION: SOURCE => is performed by => TARGET" xsd:string
property_value: IAO:0000232 "There is OMOP 4160030, but it is a more general type of performed." xsd:string

[Term]
id: CLCO:0000013
name: is referred by
def: "Statement indicating that the patient has been referred by a clinician" []
xref: OMOP_CONCEPT_ID:44792349
xref: SNOMED:342701000000109
is_a: CLCO:0000003 ! clinical administration
relationship: CLCO:0002501 CLCO:0000108 ! has object clinician
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "PHI is referred by Dr.  PHI  with PMH significant for IP" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"referred by her primary care physician\" => is referred by\n\"sent by the emergency physician\" => is referred by\n\"referred by the oncologist\" => is referred by\n\nNEGATIVE EXAMPLES:\n\"performed by Dr. Smith\" => is performed by, NOT is referred by\n\"seen by the cardiologist\" => is seen by, NOT is referred by\n\"recommended by the physician\" => recommended, NOT is referred by\n\nCONTEXTUAL EXAMPLES:\n\"The patient was referred by her primary care physician.\"\nSOURCE: \"patient\" => patient; TARGET: \"primary care physician\" => clinician\nRELATION: SOURCE => is referred by => TARGET\n\"He was sent by the emergency physician.\"\nSOURCE: \"patient\" => patient; TARGET: \"emergency physician\" => clinician\nRELATION: SOURCE => is referred by => TARGET\n\"She was referred by the oncologist.\"\nSOURCE: \"patient\" => patient; TARGET: \"oncologist\" => clinician\nRELATION: SOURCE => is referred by => TARGET" xsd:string

[Term]
id: CLCO:0000014
name: is seen by
def: "Statement indicating that the patient has seen a clinician" []
xref: OMOP_CONCEPT_ID:4091832
xref: SNOMED:281033004
is_a: CLCO:0000003 ! clinical administration
relationship: CLCO:0002501 CLCO:0000108 ! has object clinician
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "[Speaker 2]: I went to the ENT at PHI and they prescribed Allegra D, and I took those, they cleared it up, but they also affected my blood pressure" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"seen by cardiology\" => is seen by\n\"evaluated by the surgeon\" => is seen by\n\"followed by a neurologist\" => is seen by\n\nNEGATIVE EXAMPLES:\n\"referred by Dr. Smith\" => is referred by, NOT is seen by\n\"performed by Dr. Smith\" => is performed by, NOT is seen by\n\"recommended by the physician\" => recommended, NOT is seen by\n\nCONTEXTUAL EXAMPLES:\n\"The patient was seen by cardiology.\"\nSOURCE: \"patient\" => patient; TARGET: \"cardiology\" => clinician\nRELATION: SOURCE => is seen by => TARGET\n\"She was evaluated by the surgeon.\"\nSOURCE: \"patient\" => patient; TARGET: \"surgeon\" => clinician\nRELATION: SOURCE => is seen by => TARGET\n\"He is followed by a neurologist.\"\nSOURCE: \"patient\" => patient; TARGET: \"neurologist\" => clinician\nRELATION: SOURCE => is seen by => TARGET" xsd:string
property_value: IAO:0000232 "Mapping to seen by health care giver which I think is the intention here." xsd:string

[Term]
id: CLCO:0000015
name: is transferred from
def: "Source of patient transference" []
xref: OMOP_CONCEPT_ID:4144257
xref: SNOMED:266751003
is_a: CLCO:0000058 ! has setting
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"transferred from the emergency department\" => is transferred from\n\"sent from the outside hospital\" => is transferred from\n\"moved from the ward\" => is transferred from\n\nNEGATIVE EXAMPLES:\n\"transferred to the ICU\" => is transferred to, NOT is transferred from\n\"admitted to the hospital\" => is admitted, NOT is transferred from\n\"discharged home\" => is discharged, NOT is transferred from\n\nCONTEXTUAL EXAMPLES:\n\"The patient was transferred from the emergency department.\"\nSOURCE: \"patient\" => patient; TARGET: \"emergency department\" => setting\nRELATION: SOURCE => is transferred from => TARGET\n\"She was sent from the outside hospital.\"\nSOURCE: \"patient\" => patient; TARGET: \"outside hospital\" => setting\nRELATION: SOURCE => is transferred from => TARGET\n\"He was moved from the ward.\"\nSOURCE: \"patient\" => patient; TARGET: \"ward\" => setting\nRELATION: SOURCE => is transferred from => TARGET" xsd:string
property_value: IAO:0000232 "Actually \"transferred from department\" but it includes hospitals and other facilities and appears to be a general concept." xsd:string

[Term]
id: CLCO:0000017
name: has effect
def: "Statement about the effect of an intervention." []
xref: OMOP_CONCEPT_ID:44818727
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002501 CLCO:0000101 ! has object finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"relieved the pain\" => has effect\n\"lowered blood pressure\" => has effect\n\"caused nausea\" => has effect\n\nNEGATIVE EXAMPLES:\n\"was given for pain\" => has reason, NOT has effect\n\"was recommended\" => recommended, NOT has effect\n\"was performed by the surgeon\" => is performed by, NOT has effect\n\nCONTEXTUAL EXAMPLES:\n\"Nitroglycerin relieved the chest pain.\"\nSOURCE: \"nitroglycerin\" => intervention; TARGET: \"chest pain\" => finding\nRELATION: SOURCE => has effect => TARGET\n\"The medication lowered her blood pressure.\"\nSOURCE: \"medication\" => intervention; TARGET: \"blood pressure\" => finding\nRELATION: SOURCE => has effect => TARGET\n\"The antibiotic caused diarrhea.\"\nSOURCE: \"antibiotic\" => intervention; TARGET: \"diarrhea\" => finding\nRELATION: SOURCE => has effect => TARGET" xsd:string
property_value: IAO:0000112 "SL nitroglycerin alleviated pain." xsd:string

[Term]
id: CLCO:0000019
name: has frequency
def: "Statement indicating the frequency of a finding/condition or intervention" []
xref: biolink:frequency_qualifier
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000103 ! has object time
property_value: IAO:0000232 "SNOMED 162451001 is symptom frequency, break this down into intervention and condition/symptom/finding frequency." xsd:string

[Term]
id: CLCO:0000021
name: has intervention
def: "Intervention is initiated or executed to treat a present or presumed finding or condition." []
xref: SNOMED:718771000000107
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002501 CLCO:0000102 ! has object intervention
property_value: IAO:0000112 "Chest Pain: \"she took a SL NTG\"" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"started chemotherapy\" => has intervention\n\"underwent surgery\" => has intervention\n\"received physical therapy\" => has intervention\n\nNEGATIVE EXAMPLES:\n\"was diagnosed with pneumonia\" => has finding, NOT has intervention\n\"was referred to cardiology\" => is referred by, NOT has intervention\n\"was admitted to the ICU\" => is admitted, NOT has intervention\n\nCONTEXTUAL EXAMPLES:\n\"The patient started chemotherapy for lymphoma.\"\nSOURCE: \"patient\" => patient; TARGET: \"chemotherapy\" => intervention\nRELATION: SOURCE => has intervention => TARGET\n\"She underwent surgery for appendicitis.\"\nSOURCE: \"patient\" => patient; TARGET: \"surgery\" => intervention\nRELATION: SOURCE => has intervention => TARGET\n\"He received physical therapy after the stroke.\"\nSOURCE: \"patient\" => patient; TARGET: \"physical therapy\" => intervention\nRELATION: SOURCE => has intervention => TARGET" xsd:string
property_value: IAO:0000232 "SNOMED has partial mapping as qualifier." xsd:string

[Term]
id: CLCO:0000022
name: has onset
def: "The onset of a finding/condition" []
xref: biolink:onset_qualifier
xref: OMOP_CONCEPT_ID:4297758
xref: SNOMED:77374008
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000103 ! has object time
relationship: CLCO:0002502 CLCO:0000101 ! has subject finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"began yesterday\" => has onset\n\"started two weeks ago\" => has onset\n\"new-onset atrial fibrillation\" => has onset\n\nNEGATIVE EXAMPLES:\n\"lasting two weeks\" => has duration, NOT has onset\n\"worsening over time\" => has course, NOT has onset\n\"at the hospital\" => has setting, NOT has onset\n\nCONTEXTUAL EXAMPLES:\n\"The vomiting began this morning.\"\nSOURCE: \"vomiting\" => finding; TARGET: \"this morning\" => time\nRELATION: SOURCE => has onset => TARGET\n\"She developed atrial fibrillation yesterday.\"\nSOURCE: \"atrial fibrillation\" => finding; TARGET: \"yesterday\" => time\nRELATION: SOURCE => has onset => TARGET\n\"He has new-onset weakness.\"\nSOURCE: \"weakness\" => finding; TARGET: \"new-onset\" => time\nRELATION: SOURCE => has onset => TARGET" xsd:string
property_value: IAO:0000112 "Vomiting since this morning" xsd:string

[Term]
id: CLCO:0000023
name: has location
def: "Inference about the care setting in which an event happened. The object is a setting, not an anatomical site; for the body site of a finding use has spatial orientation or has laterality." []
xref: OMOP_CONCEPT_ID:3469026
xref: SNOMED:18720000
is_a: CLCO:0000058 ! has setting
relationship: CLCO:0002501 CLCO:0000107 ! has object setting
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"performed in the operating room\" => has location\n\"seen in clinic\" => has location\n\"treated at home\" => has location\n\nNEGATIVE EXAMPLES:\n\"performed by Dr. Smith\" => is performed by, NOT has location\n\"performed tomorrow\" => has date, NOT has location\n\"performed because of pain\" => has reason, NOT has location\n\nCONTEXTUAL EXAMPLES:\n\"The procedure was performed in the operating room.\"\nSOURCE: \"procedure\" => intervention; TARGET: \"operating room\" => setting\nRELATION: SOURCE => has location => TARGET\n\"The patient was seen in clinic.\"\nSOURCE: \"patient\" => patient; TARGET: \"clinic\" => setting\nRELATION: SOURCE => has location => TARGET\n\"The wound was treated at home.\"\nSOURCE: \"wound\" => finding; TARGET: \"home\" => setting\nRELATION: SOURCE => has location => TARGET" xsd:string
property_value: IAO:0000232 "Object changed from finding site (CLCO:0000112) to setting (CLCO:0000107) on 2026-10-30, and the subject widened to admit patient. The restriction asserted an anatomical site while every example used a care setting -- \"operating room\", \"clinic\", \"home\" -- and the class is subClassOf has setting (CLCO:0000058), so both the hierarchy and the examples indicated care setting. Anatomical location is reached through has spatial orientation (CLCO:0000072) or has laterality (CLCO:0000073)." xsd:string

[Term]
id: CLCO:0000024
name: has value
def: "Information that describes or quantifies a finding/condition or intervention." []
xref: OMOP_CONCEPT_ID:4306768
xref: SNOMED:83568003
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000106 ! has object value
property_value: IAO:0000112 "Describes pressure-like chest pain near L breast with radiation down R arm" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"38.5 degrees Celsius\" => has value\n\"severe\" => has value\n\"positive for influenza\" => has value\n\nNEGATIVE EXAMPLES:\n\"fever\" => finding, NOT has value\n\"MRI\" => intervention, NOT has value\n\"three weeks\" => time, NOT has value\n\nCONTEXTUAL EXAMPLES:\n\"The temperature was 38.5 degrees Celsius.\"\nSOURCE: \"temperature\" => finding; TARGET: \"38.5 degrees Celsius\" => value\nRELATION: SOURCE => has value => TARGET\n\"The pain was severe.\"\nSOURCE: \"pain\" => finding; TARGET: \"severe\" => value\nRELATION: SOURCE => has value => TARGET\n\"The test was positive for influenza.\"\nSOURCE: \"test\" => intervention; TARGET: \"positive for influenza\" => value\nRELATION: SOURCE => has value => TARGET" xsd:string

[Term]
id: CLCO:0000025
name: has finding
def: "Statement indicating that the patient or a specific finding site has a finding or condition." []
xref: OMOP_CONCEPT_ID:44818789
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000101 ! has object finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"patient has pneumonia\" => has finding\n\"examination revealed a murmur\" => has finding\n\"the scan showed a mass\" => has finding\n\nNEGATIVE EXAMPLES:\n\"patient underwent surgery\" => has intervention, NOT has finding\n\"patient is a physician\" => has subject qualifier, NOT has finding\n\"patient was admitted\" => is admitted, NOT has finding\n\nCONTEXTUAL EXAMPLES:\n\"The patient has pneumonia.\"\nSOURCE: \"patient\" => patient; TARGET: \"pneumonia\" => finding\nRELATION: SOURCE => has finding => TARGET\n\"The patient has a heart murmur.\"\nSOURCE: \"patient\" => patient; TARGET: \"heart murmur\" => finding\nRELATION: SOURCE => has finding => TARGET\n\"The right lower lobe shows consolidation.\"\nSOURCE: \"right lower lobe\" => finding site; TARGET: \"consolidation\" => finding\nRELATION: SOURCE => has finding => TARGET\nA diagnostic test or document that reveals a finding is not the bearer of it. \"The CT scan showed a\npulmonary mass\" is suggests finding, whose subject may be an intervention or a documentation; the\nsubject of has finding is the patient or the body site." xsd:string
property_value: IAO:0000112 "The patient reported sore throat and his physical indicated swollen lymph nodes." xsd:string
property_value: IAO:0000232 "Was can_cause_finding_or_condition, a statement of medical knowledge about the potential cause of a finding/condition. Now just has_finding." xsd:string

[Term]
id: CLCO:0000027
name: has abandonment reason
def: "Statement providing the reason for abandoning an intervention or diagnostic process" []
is_a: CLCO:0000006 ! clinical explanation
property_value: IAO:0000112 "A cystogram was attempted today but radiology was unable to inject dye through her catheter." xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"stopped because of hypotension\" => has abandonment reason\n\"procedure canceled due to poor tolerance\" => has abandonment reason\n\"test was not completed because the patient declined\" => has abandonment reason\n\nNEGATIVE EXAMPLES:\n\"procedure was completed\" => completed, NOT has abandonment reason\n\"procedure was recommended\" => recommended, NOT has abandonment reason\n\"procedure caused bleeding\" => has effect, NOT has abandonment reason\n\nCONTEXTUAL EXAMPLES:\n\"The cystogram was abandoned because the catheter could not be accessed.\"\nSOURCE: \"cystogram\" => intervention; TARGET: \"catheter could not be accessed\" => reason\nRELATION: SOURCE => has abandonment reason => TARGET\n\"The infusion was stopped due to hypotension.\"\nSOURCE: \"infusion\" => intervention; TARGET: \"hypotension\" => finding\nRELATION: SOURCE => has abandonment reason => TARGET\n\"The patient declined the procedure, so it was canceled.\"\nSOURCE: \"procedure\" => intervention; TARGET: \"patient declined\" => reason\nRELATION: SOURCE => has abandonment reason => TARGET" xsd:string

[Term]
id: CLCO:0000028
name: has assessment
def: "Statement inferring that a finding/condition was assessed." []
xref: OMOP_CONCEPT_ID:4195693
is_a: CLCO:0000006 ! clinical explanation
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"assessed for pulmonary embolism\" => has assessment\n\"evaluated for appendicitis\" => has assessment\n\"screened for depression\" => has assessment\n\nNEGATIVE EXAMPLES:\n\"unable to assess for syncope\" => do not assert has assessment\n\"treated for pneumonia\" => has intervention, NOT has assessment\n\"history of diabetes\" => has finding, NOT has assessment\n\nCONTEXTUAL EXAMPLES:\n\"The patient was assessed for pulmonary embolism.\"\nSOURCE: \"patient\" => patient; TARGET: \"pulmonary embolism\" => finding\nRELATION: SOURCE => has assessment => TARGET\n\"She was evaluated for appendicitis.\"\nSOURCE: \"patient\" => patient; TARGET: \"appendicitis\" => finding\nRELATION: SOURCE => has assessment => TARGET\n\"The patient was screened for depression.\"\nSOURCE: \"patient\" => patient; TARGET: \"depression\" => finding\nRELATION: SOURCE => has assessment => TARGET" xsd:string
property_value: IAO:0000112 "unable to assess for h/o exertional syncope, angina, dyspnea, etc which would warrant ICD placement" xsd:string
property_value: IAO:0000232 "It is anticipated that this relation will usually be negative (as seen in the example) and refer to the absence of an assessment for a particular condition." xsd:string

[Term]
id: CLCO:0000030
name: has reason
def: "Any clinical justification or reason for ordering any intervention, including planning. If the reason is suspected, it would be qualified as uncertain." []
xref: OMOP_CONCEPT_ID:4165917
xref: SNOMED:416083004
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002502 CLCO:0000102 ! has subject intervention
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"ordered because of hyperkalemia\" => has reason\n\"started for treatment of pneumonia\" => has reason\n\"discontinued due to adverse effects\" => has reason\n\nNEGATIVE EXAMPLES:\n\"was caused by pneumonia\" => is caused by, NOT has reason\n\"was recommended\" => recommended, NOT has reason\n\"was suspected\" => uncertainty, NOT has reason\n\nCONTEXTUAL EXAMPLES:\n\"Bactrim was stopped because it worsened hyperkalemia.\"\nSOURCE: \"Bactrim\" => intervention; TARGET: \"worsened hyperkalemia\" => reason\nRELATION: SOURCE => has reason => TARGET\n\"The MRI was ordered because of persistent headaches.\"\nSOURCE: \"MRI\" => intervention; TARGET: \"persistent headaches\" => finding\nRELATION: SOURCE => has reason => TARGET\n\"Physical therapy was started to improve mobility.\"\nSOURCE: \"physical therapy\" => intervention; TARGET: \"improve mobility\" => reason\nRELATION: SOURCE => has reason => TARGET" xsd:string
property_value: IAO:0000112 "stop Bactrim which may worsen hyperK" xsd:string

[Term]
id: CLCO:0000031
name: has state
def: "Statement related to patient physiologic state" []
xref: OMOP_CONCEPT_ID:4028872
xref: SNOMED:128973006
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000113 ! has object patient state
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"patient is stable\" => has state\n\"patient is improving\" => has state\n\"patient is alert and oriented\" => has state\n\nNEGATIVE EXAMPLES:\n\"stable disease\" => has course, NOT has state\n\"chest pain\" => has finding, NOT has state\n\"physician\" => clinician, NOT has state\n\nCONTEXTUAL EXAMPLES:\n\"The patient is clinically stable.\"\nSOURCE: \"patient\" => patient; TARGET: \"clinically stable\" => patient state\nRELATION: SOURCE => has state => TARGET\n\"The patient is improving after treatment.\"\nSOURCE: \"patient\" => patient; TARGET: \"improving\" => patient state\nRELATION: SOURCE => has state => TARGET\n\"The patient is alert and oriented.\"\nSOURCE: \"patient\" => patient; TARGET: \"alert and oriented\" => patient state\nRELATION: SOURCE => has state => TARGET" xsd:string
property_value: IAO:0000232 "Was represented earlier as \"finding related physiological patient state\"" xsd:string

[Term]
id: CLCO:0000034
name: has trigger
def: "Statement indicating that an intervention or task will be triggered by an event" []
xref: OMOP_CONCEPT_ID:44787854
xref: SNOMED:109721000000108
is_a: CLCO:0000006 ! clinical explanation
property_value: IAO:0000112 "Please call if we can be of further assistance or his echo is abnormal" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"if fever develops, call the clinic\" => has trigger\n\"abnormal results prompted admission\" => has trigger\n\"worsening symptoms led to escalation\" => has trigger\n\nNEGATIVE EXAMPLES:\n\"admission was caused by pneumonia\" => is caused by, NOT has trigger\n\"admission was recommended\" => recommended, NOT has trigger\n\"admission is suspected\" => uncertainty, NOT has trigger\n\nCONTEXTUAL EXAMPLES:\n\"If the fever returns, call the clinic.\"\nSOURCE: \"call the clinic\" => task; TARGET: \"fever returns\" => finding\nRELATION: SOURCE => has trigger => TARGET\n\"The abnormal CT result prompted admission.\"\nSOURCE: \"admission\" => intervention; TARGET: \"abnormal CT result\" => finding\nRELATION: SOURCE => has trigger => TARGET\n\"Worsening hypoxia led to escalation of respiratory support.\"\nSOURCE: \"escalation of respiratory support\" => intervention; TARGET: \"worsening hypoxia\" => finding\nRELATION: SOURCE => has trigger => TARGET" xsd:string
property_value: IAO:0000232 "Referred by trigger criteria may be best fit." xsd:string

[Term]
id: CLCO:0000035
name: has visit rationale
def: "Rationale for an outpatient visit" []
xref: LOINC:29298-7
xref: OMOP_CONCEPT_ID:3025141
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "PHI presents today for follow-up evaluation regarding management of lower urinary tract symptoms." xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"visit for follow-up of lower urinary tract symptoms\" => has visit rationale\n\"seen for evaluation of chest pain\" => has visit rationale\n\"return visit for medication management\" => has visit rationale\n\nNEGATIVE EXAMPLES:\n\"was referred by Dr. Smith\" => is referred by, NOT has visit rationale\n\"was admitted to the ICU\" => is admitted, NOT has visit rationale\n\"was treated with antibiotics\" => has intervention, NOT has visit rationale\n\nCONTEXTUAL EXAMPLES:\n\"The patient presented for follow-up of lower urinary tract symptoms.\"\nSOURCE: \"patient\" => patient; TARGET: \"lower urinary tract symptoms\" => finding\nRELATION: SOURCE => has visit rationale => TARGET\n\"She was seen for evaluation of chest pain.\"\nSOURCE: \"patient\" => patient; TARGET: \"chest pain\" => finding\nRELATION: SOURCE => has visit rationale => TARGET\n\"He returned for medication management.\"\nSOURCE: \"patient\" => patient; TARGET: \"medication management\" => intervention\nRELATION: SOURCE => has visit rationale => TARGET" xsd:string
property_value: IAO:0000232 "Was previously \"has visit reason\" but the object was finding or intervention, not reason. Name was therefore changed to rationale to avoid confusion." xsd:string

[Term]
id: CLCO:0000036
name: is caused by
def: "Statement about the cause of a finding/condition" []
xref: LOINC:LP430632-2
xref: OMOP_CONCEPT_ID:1992175
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002502 CLCO:0000101 ! has subject finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"fracture caused by a fall\" => is caused by\n\"dyspnea due to pneumonia\" => is caused by\n\"bleeding secondary to anticoagulation\" => is caused by\n\nNEGATIVE EXAMPLES:\n\"MRI ordered because of headache\" => has reason, NOT is caused by\n\"possible pneumonia\" => uncertainty, NOT is caused by\n\"fever preceded the rash\" => precedes, NOT is caused by\n\nCONTEXTUAL EXAMPLES:\n\"The fracture was caused by a fall.\"\nSOURCE: \"fracture\" => finding; TARGET: \"fall\" => finding\nRELATION: SOURCE => is caused by => TARGET\n\"The dyspnea was due to pneumonia.\"\nSOURCE: \"dyspnea\" => finding; TARGET: \"pneumonia\" => finding\nRELATION: SOURCE => is caused by => TARGET\n\"Bleeding was secondary to anticoagulation.\"\nSOURCE: \"bleeding\" => finding; TARGET: \"anticoagulation\" => intervention\nRELATION: SOURCE => is caused by => TARGET" xsd:string
property_value: IAO:0000112 "She had a MVC that resulted in extraperitoneal bladder injury and pelvic and sacral fractures." xsd:string
property_value: IAO:0000232 "There is condition cause which is non-standard LOINC" xsd:string

[Term]
id: CLCO:0000037
name: is complicated by
def: "Statement indicating that procedure, intervention or finding/condition is complicated by an event" []
xref: OMOP_CONCEPT_ID:4137797
xref: SNOMED:263718001
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002501 CLCO:0000101 ! has object finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"wound complicated by infection\" => is complicated by\n\"surgery complicated by bleeding\" => is complicated by\n\"fracture complicated by nonunion\" => is complicated by\n\nNEGATIVE EXAMPLES:\n\"infection caused the wound\" => is caused by, NOT is complicated by\n\"surgery was followed by bleeding\" => precedes, NOT is complicated by\n\"bleeding was suspected\" => uncertainty, NOT is complicated by\n\nCONTEXTUAL EXAMPLES:\n\"The wound was complicated by infection.\"\nSOURCE: \"wound\" => finding; TARGET: \"infection\" => finding\nRELATION: SOURCE => is complicated by => TARGET\n\"The surgery was complicated by bleeding.\"\nSOURCE: \"surgery\" => intervention; TARGET: \"bleeding\" => finding\nRELATION: SOURCE => is complicated by => TARGET\n\"The fracture was complicated by nonunion.\"\nSOURCE: \"fracture\" => finding; TARGET: \"nonunion\" => finding\nRELATION: SOURCE => is complicated by => TARGET" xsd:string
property_value: IAO:0000112 "She reports her catheter has been leaking today especially when trying to have a bowel movement." xsd:string
property_value: IAO:0000232 "Using complications, but not a relationship, may need new term." xsd:string

[Term]
id: CLCO:0000038
name: is consistent with diagnosis
def: "A diagnostic process outcome is consistent with a condition. Whether this process is required or sufficient is not addressed." []
is_a: CLCO:0000006 ! clinical explanation
relationship: CLCO:0002501 CLCO:0000101 ! has object finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"imaging consistent with pneumonia\" => is consistent with diagnosis\n\"biopsy consistent with malignancy\" => is consistent with diagnosis\n\"findings consistent with appendicitis\" => is consistent with diagnosis\n\nNEGATIVE EXAMPLES:\n\"imaging ruled out pneumonia\" => negation, NOT is consistent with diagnosis\n\"biopsy suggested possible malignancy\" => uncertainty, NOT is consistent with diagnosis\n\"MRI was ordered for headache\" => has reason, NOT is consistent with diagnosis\n\nCONTEXTUAL EXAMPLES:\n\"The CT findings were consistent with pneumonia.\"\nSOURCE: \"CT findings\" => finding; TARGET: \"pneumonia\" => finding\nRELATION: SOURCE => is consistent with diagnosis => TARGET\n\"The biopsy was consistent with malignancy.\"\nSOURCE: \"biopsy\" => intervention; TARGET: \"malignancy\" => finding\nRELATION: SOURCE => is consistent with diagnosis => TARGET\n\"The clinical findings were consistent with appendicitis.\"\nSOURCE: \"clinical findings\" => finding; TARGET: \"appendicitis\" => finding\nRELATION: SOURCE => is consistent with diagnosis => TARGET" xsd:string
property_value: IAO:0000232 "Was \"Statement indicating that a diagnostic process does not suggest a finding/condition\"." xsd:string

[Term]
id: CLCO:0000040
name: treatment reason
def: "A clinical reason related to a treatment such as procedure, medication, or lifestyle recommendation." []
is_a: CLCO:0000006 ! clinical explanation
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"antibiotics for pneumonia\" => treatment reason\n\"physical therapy to improve mobility\" => treatment reason\n\"smoking cessation to reduce cardiovascular risk\" => treatment reason\n\nNEGATIVE EXAMPLES:\n\"antibiotics caused diarrhea\" => has effect, NOT treatment reason\n\"antibiotics were recommended\" => recommended, NOT treatment reason\n\"antibiotics were suspected\" => uncertainty, NOT treatment reason\n\nCONTEXTUAL EXAMPLES:\n\"Antibiotics were prescribed for pneumonia.\"\nSOURCE: \"antibiotics\" => intervention; TARGET: \"pneumonia\" => finding\nRELATION: SOURCE => treatment reason => TARGET\n\"Physical therapy was ordered to improve mobility.\"\nSOURCE: \"physical therapy\" => intervention; TARGET: \"improve mobility\" => reason\nRELATION: SOURCE => treatment reason => TARGET\n\"Smoking cessation was advised to reduce cardiovascular risk.\"\nSOURCE: \"smoking cessation\" => intervention; TARGET: \"reduce cardiovascular risk\" => reason\nRELATION: SOURCE => treatment reason => TARGET" xsd:string

[Term]
id: CLCO:0000041
name: agree with
def: "Statement denoting a clinician's or patient's agreement with another clinician's assessment, recommendation or reasoning." []
xref: OMOP_CONCEPT_ID:37018830
xref: SNOMED:714831004
is_a: CLCO:0000005 ! clinical decision
property_value: IAO:0000112 "I saw and evaluated the patient. I reviewed the findings and assessment/plan outlined above by PHI and agree" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"agreed to proceed with surgery\" => agree with\n\"concurred with the treatment plan\" => agree with\n\"accepted the recommendation\" => agree with\n\nNEGATIVE EXAMPLES:\n\"declined surgery\" => negation or has decision, NOT agree with\n\"recommended surgery\" => recommended, NOT agree with\n\"suspected pneumonia\" => uncertainty, NOT agree with\n\nCONTEXTUAL EXAMPLES:\n\"The patient agreed to proceed with surgery.\"\nSOURCE: \"patient\" => patient; TARGET: \"surgery\" => intervention\nRELATION: SOURCE => agree with => TARGET\n\"The family concurred with the treatment plan.\"\nSOURCE: \"family\" => family member; TARGET: \"treatment plan\" => intervention\nRELATION: SOURCE => agree with => TARGET\n\"The patient accepted the care plan.\"\nSOURCE: \"patient\" => patient; TARGET: \"care plan\" => documentation\nRELATION: SOURCE => agree with => TARGET" xsd:string
property_value: IAO:0000232 "Mapping to \"does agree with care plan\"." xsd:string

[Term]
id: CLCO:0000042
name: has goal
def: "Indication that an intervention or the patient has an outcome goal (target)" []
xref: OMOP_CONCEPT_ID:4253630
is_a: CLCO:0000005 ! clinical decision
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"goal of pain control\" => has goal\n\"target blood pressure below 130/80\" => has goal\n\"aim of preventing recurrence\" => has goal\n\nNEGATIVE EXAMPLES:\n\"reason for surgery\" => has reason, NOT has goal\n\"recommended surgery\" => recommended, NOT has goal\n\"completed treatment\" => completed, NOT has goal\n\nCONTEXTUAL EXAMPLES:\n\"The goal is pain control.\"\nSOURCE: \"intervention\" => intervention; TARGET: \"pain control\" => finding\nRELATION: SOURCE => has goal => TARGET\n\"The target blood pressure is below 130/80.\"\nSOURCE: \"blood pressure management\" => intervention; TARGET: \"below 130/80\" => value\nRELATION: SOURCE => has goal => TARGET\n\"The aim is to prevent recurrence.\"\nSOURCE: \"treatment\" => intervention; TARGET: \"prevent recurrence\" => finding\nRELATION: SOURCE => has goal => TARGET" xsd:string
property_value: IAO:0000112 "Ultimately her goal is to not have to live with bilateral nephrostomy tubes." xsd:string
property_value: IAO:0000232 "OMOP 4253630 \"Goal\"  doesn't really match well, we may need a new term." xsd:string

[Term]
id: CLCO:0000043
name: has decision
def: "A statement indicating that a clinician or patient has a decision concerning an intervention." []
is_a: CLCO:0000005 ! clinical decision
relationship: CLCO:0002501 CLCO:0000102 ! has object intervention
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"decided to order an MRI\" => has decision\n\"decision to start chemotherapy\" => has decision\n\"will discuss surgical repair\" => has decision\n\nNEGATIVE EXAMPLES:\n\"MRI was performed\" => is performed by or completed, NOT has decision\n\"MRI was recommended\" => recommended, NOT has decision\n\"MRI was suspected\" => uncertainty, NOT has decision\n\nCONTEXTUAL EXAMPLES:\n\"The clinician decided to order an MRI.\"\nSOURCE: \"clinician\" => clinician; TARGET: \"order an MRI\" => intervention\nRELATION: SOURCE => has decision => TARGET\n\"The team decided to start chemotherapy.\"\nSOURCE: \"team\" => clinician; TARGET: \"start chemotherapy\" => intervention\nRELATION: SOURCE => has decision => TARGET\n\"The patient will discuss surgical repair.\"\nSOURCE: \"patient\" => patient; TARGET: \"surgical repair\" => intervention\nRELATION: SOURCE => has decision => TARGET" xsd:string
property_value: IAO:0000112 "Will discuss with interventional in AM about possible pulmonary vein dilation w/stenting" xsd:string
property_value: IAO:0000232 "May needs new label, was previously has_pending_decision, but with modifieres this can be scoped more specifically." xsd:string

[Term]
id: CLCO:0000044
name: is at goal
def: "Statement indicating that a finding/condition, an intervention or the patient is at goal. Being at goal may be expressed as a value, a course, or a state of the patient." []
xref: OMOP_CONCEPT_ID:4191706
xref: SNOMED:390802008
is_a: CLCO:0000005 ! clinical decision
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"at goal\" => is at goal\n\"met the target\" => is at goal\n\"reached the desired blood pressure\" => is at goal\n\nNEGATIVE EXAMPLES:\n\"goal of pain control\" => has goal, NOT is at goal\n\"worsening symptoms\" => has course, NOT is at goal\n\"recommended target\" => recommended, NOT is at goal\n\nCONTEXTUAL EXAMPLES:\n\"The patient's blood pressure is at goal.\"\nSOURCE: \"blood pressure\" => finding; TARGET: \"at goal\" => patient state\nRELATION: SOURCE => is at goal => TARGET\n\"The treatment met the target.\"\nSOURCE: \"treatment\" => intervention; TARGET: \"target\" => value\nRELATION: SOURCE => is at goal => TARGET\n\"The patient reached the desired glucose level.\"\nSOURCE: \"patient\" => patient; TARGET: \"desired glucose level\" => value\nRELATION: SOURCE => is at goal => TARGET" xsd:string
property_value: IAO:0000232 "Goal achieved in SNOMED, rename if acceptable." xsd:string
property_value: IAO:0000232 "Subject and object widened on 2026-10-30. Being at goal is asserted of a finding (\"blood pressure is at goal\"), of an intervention (\"the treatment met the target\") and of the patient (\"the patient reached the desired glucose level\"); the goal itself is sometimes a state of the patient rather than a value or a course." xsd:string

[Term]
id: CLCO:0000045
name: has documentation
def: "Statement that a finding or condition is documented in a clinical document. The subject is the finding; the object is the document that records it." []
xref: OMOP_CONCEPT_ID:4205679
xref: SNOMED:308910008
is_a: CLCO:0000049 ! has confirmation
relationship: CLCO:0002501 CLCO:0000111 ! has object documentation
relationship: CLCO:0002502 CLCO:0000101 ! has subject finding
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"hypertension is documented in the record\" => has documentation\n\"the mass is described in the imaging report\" => has documentation\n\"anemia is noted in the discharge summary\" => has documentation\n\nNEGATIVE EXAMPLES:\n\"the patient has hypertension\" => has finding, NOT has documentation\n\"the patient underwent surgery\" => has intervention, NOT has documentation\n\"the physician recommended treatment\" => recommended, NOT has documentation\n\nCONTEXTUAL EXAMPLES:\n\"The medical record documents hypertension.\"\nSOURCE: \"hypertension\" => finding; TARGET: \"medical record\" => documentation\nRELATION: SOURCE => has documentation => TARGET\n\"The imaging report describes a pulmonary mass.\"\nSOURCE: \"pulmonary mass\" => finding; TARGET: \"imaging report\" => documentation\nRELATION: SOURCE => has documentation => TARGET\n\"The discharge summary notes anemia.\"\nSOURCE: \"anemia\" => finding; TARGET: \"discharge summary\" => documentation\nRELATION: SOURCE => has documentation => TARGET" xsd:string
property_value: IAO:0000232 "Maps to SNOMED qualifier Reference documentation which is probably equivalent." xsd:string
property_value: IAO:0000232 "Renamed from \"documentation of finding\" on 2026-10-30. The asserted restrictions -- subject finding (CLCO:0000101), object documentation (CLCO:0000111) -- were kept, and the examples, which had subject and object the other way round, were flipped to match. The old label was a noun phrase that did not indicate a direction, so it could be read either way; \"has documentation\" follows the has-X convention used by the other associations and reads in the same direction as the axiom. The SNOMED and OMOP mappings are unchanged and still describe the same relation." xsd:string

[Term]
id: CLCO:0000046
name: is eligible
def: "Statement indicating that the patient is a candidate for a given intervention, commonly used in the negative." []
is_a: CLCO:0000040 ! treatment reason
relationship: CLCO:0002501 CLCO:0000102 ! has object intervention
relationship: CLCO:0002502 CLCO:0000110 ! has subject patient
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"eligible for surgery\" => is eligible\n\"eligible for transplant evaluation\" => is eligible\n\"meets criteria for chemotherapy\" => is eligible\n\nNEGATIVE EXAMPLES:\n\"contraindicated for surgery\" => has contraindication, NOT is eligible\n\"referred for surgery\" => is referred by, NOT is eligible\n\"scheduled for surgery\" => has intention, NOT is eligible\n\nCONTEXTUAL EXAMPLES:\n\"The patient is eligible for surgery.\"\nSOURCE: \"patient\" => patient; TARGET: \"surgery\" => intervention\nRELATION: SOURCE => is eligible => TARGET\n\"She meets criteria for transplant evaluation.\"\nSOURCE: \"patient\" => patient; TARGET: \"transplant evaluation\" => intervention\nRELATION: SOURCE => is eligible => TARGET\n\"He is eligible for chemotherapy.\"\nSOURCE: \"patient\" => patient; TARGET: \"chemotherapy\" => intervention\nRELATION: SOURCE => is eligible => TARGET" xsd:string

[Term]
id: CLCO:0000048
name: discussed with
def: "Statement indicating that an intervention has been discussed with patient by a clinician (clinician initiated) or a patient has discussed an intervention with their clinician (patient initiated). The default assumption should be that the discussion is clinician initiated." []
is_a: CLCO:0000049 ! has confirmation
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"discussed surgery with the patient\" => discussed with\n\"reviewed chemotherapy with the family\" => discussed with\n\"discussed the MRI with cardiology\" => discussed with\n\nNEGATIVE EXAMPLES:\n\"recommended surgery\" => recommended, NOT discussed with\n\"performed surgery\" => completed, NOT discussed with\n\"referred to cardiology\" => is referred by, NOT discussed with\n\nCONTEXTUAL EXAMPLES:\n\"The surgeon discussed surgery with the patient.\"\nSOURCE: \"surgery\" => intervention; TARGET: \"patient\" => patient\nRELATION: SOURCE => discussed with => TARGET\n\"Chemotherapy was reviewed with the family.\"\nSOURCE: \"chemotherapy\" => intervention; TARGET: \"family\" => family member\nRELATION: SOURCE => discussed with => TARGET\n\"The MRI was discussed with cardiology.\"\nSOURCE: \"MRI\" => intervention; TARGET: \"cardiology\" => clinician\nRELATION: SOURCE => discussed with => TARGET" xsd:string
property_value: IAO:0000232 "Likely need to break this down for reasoning, values available include separate concepts for discussion with caregiver, patient, specialist, pharmacist, payer, etc..." xsd:string

[Term]
id: CLCO:0000049
name: has confirmation
def: "A decision or status has been confirmed." []
xref: OMOP_CONCEPT_ID:4326761
xref: SNOMED:74996004
is_a: CLCO:0000003 ! clinical administration
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"confirmed diagnosis\" => has confirmation\n\"confirmed treatment plan\" => has confirmation\n\"confirmed appointment\" => has confirmation\n\nNEGATIVE EXAMPLES:\n\"suspected diagnosis\" => uncertainty, NOT has confirmation\n\"recommended treatment\" => recommended, NOT has confirmation\n\"denied symptoms\" => negation, NOT has confirmation\n\nCONTEXTUAL EXAMPLES:\n\"The diagnosis was confirmed.\"\nSOURCE: \"diagnosis\" => finding; TARGET: \"confirmed\"\nRELATION: SOURCE => has confirmation => TARGET\n\"The treatment plan was confirmed.\"\nSOURCE: \"treatment plan\" => intervention; TARGET: \"confirmed\"\nRELATION: SOURCE => has confirmation => TARGET\n\"The appointment was confirmed.\"\nSOURCE: \"appointment\" => task; TARGET: \"confirmed\"\nRELATION: SOURCE => has confirmation => TARGET" xsd:string

[Term]
id: CLCO:0000050
name: has contraindication
def: "Statement about the contraindication of an intervention. The intervention should not be used for the condition because it may cause harm to the patient or outweigh potential benefits." []
xref: OMOP_CONCEPT_ID:4011945
xref: SNOMED:103306004
is_a: CLCO:0000040 ! treatment reason
relationship: CLCO:0002501 CLCO:0000101 ! has object finding
relationship: CLCO:0002502 CLCO:0000102 ! has subject intervention
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"warfarin contraindicated in pregnancy\" => has contraindication\n\"NSAIDs contraindicated in renal failure\" => has contraindication\n\"chemotherapy contraindicated by severe neutropenia\" => has contraindication\n\nNEGATIVE EXAMPLES:\n\"warfarin prescribed for atrial fibrillation\" => has reason, NOT has contraindication\n\"chemotherapy was recommended\" => recommended, NOT has contraindication\n\"chemotherapy was suspected\" => uncertainty, NOT has contraindication\n\nCONTEXTUAL EXAMPLES:\n\"Warfarin is contraindicated in pregnancy.\"\nSOURCE: \"warfarin\" => intervention; TARGET: \"pregnancy\" => finding\nRELATION: SOURCE => has contraindication => TARGET\n\"NSAIDs are contraindicated in severe renal failure.\"\nSOURCE: \"NSAIDs\" => intervention; TARGET: \"severe renal failure\" => finding\nRELATION: SOURCE => has contraindication => TARGET\n\"Chemotherapy is contraindicated because of severe neutropenia.\"\nSOURCE: \"chemotherapy\" => intervention; TARGET: \"severe neutropenia\" => finding\nRELATION: SOURCE => has contraindication => TARGET" xsd:string
property_value: IAO:0000112 "warfarin has contraindication pregnancy." xsd:string

[Term]
id: CLCO:0000051
name: has course
def: "The course of a finding/condition" []
xref: OMOP_CONCEPT_ID:4137632
xref: SNOMED:263502005
is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000105 ! has object course
relationship: CLCO:0002502 CLCO:0000101 ! has subject finding
property_value: IAO:0000112 "Her shortness of breath is becoming worse" xsd:string
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"worsening\" => has course\n\"stable\" => has course\n\"intermittent\" => has course\n\nNEGATIVE EXAMPLES:\n\"three weeks\" => has duration, NOT has course\n\"yesterday\" => has date, NOT has course\n\"severe\" => has severity, NOT has course\n\nCONTEXTUAL EXAMPLES:\n\"The patient reports worsening weakness.\"\nSOURCE: \"weakness\" => finding; TARGET: \"worsening\" => course\nRELATION: SOURCE => has course => TARGET\n\"Her symptoms remain stable.\"\nSOURCE: \"symptoms\" => finding; TARGET: \"stable\" => course\nRELATION: SOURCE => has course => TARGET\n\"He has intermittent chest pain.\"\nSOURCE: \"chest pain\" => finding; TARGET: \"intermittent\" => course\nRELATION: SOURCE => has course => TARGET\n\"Bone density is decreasing.\"\nSOURCE: \"bone density\" => finding; TARGET: \"decreasing\" => course\nRELATION: SOURCE => has course => TARGET\n\"Cancer progression is rapid.\"\nSOURCE: \"cancer progression\" => finding; TARGET: \"rapid\" => course\nRELATION: SOURCE => has course => TARGET\nA measurable property of a body site or disease process, such as \"bone density\" or \"cancer\nprogression\", is annotated as a single finding. Do not decompose it into the site plus the property;\nthere is no cue licensing such a relation, and CLCO has no observable entity class to hold the\nproperty." xsd:string
property_value: IAO:0000232 "The same thing as clinical course." xsd:string

