is_a: CLCO:0000057 ! clinical association
relationship: CLCO:0002501 CLCO:0000103 ! has object time
property_value: IAO:0000112 "POSITIVE EXAMPLES:\n\"tomorrow\" => has date\n\"on March 3\" => has date\n\"last Tuesday\" => has date\n\nNEGATIVE EXAMPLES:\n\"for three weeks\" => has duration, NOT has date\n\"currently\" => has temporal frame, NOT has date\n\"worsening\" => has course, NOT has date\n\nCONTEXTUAL EXAMPLES:\n\"The patient has an appointment tomorrow.\"\nSOURCE: \"appointment\" => intervention; TARGET: \"tomorrow\" => time\nRELATION: SOURCE => has date => TARGET\n\"Surgery is scheduled for March 3.\"\nSOURCE: \"surgery\" => intervention; TARGET: \"March 3\" => time\nRELATION: SOURCE => has date => TARGET\n\"The symptoms began last Tuesday.\"\nSOURCE: \"symptoms\" => finding; TARGET: \"last Tuesday\" => time\nRELATION: SOURCE => has date => TARGET" xsd:string
property_value: IAO:0000112 "She has an appointment with Dr. PHI tomorrow" xsd:string
property_value: IAO:0000232 "SNOMED attribute, qualifier is also available. Start and End dates?" xsd:string

[Term]
id: CLCO:0000053
name: has duration
