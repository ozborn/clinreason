                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/CLCO_0002502"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000101"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CLCO_0000102"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>POSITIVE EXAMPLES:
&quot;spanned&quot; =&gt; includes
&quot;throughout which&quot; =&gt; includes
&quot;encompassed&quot; =&gt; includes

NEGATIVE EXAMPLES:
&quot;during&quot; =&gt; is included in, NOT includes
&quot;before&quot; =&gt; precedes, NOT includes
&quot;closed with&quot; =&gt; ended by, NOT includes

CONTEXTUAL EXAMPLES:
&quot;The admission spanned the episode of delirium.&quot;
SOURCE: &quot;admission&quot; =&gt; intervention; TARGET: &quot;delirium&quot; =&gt; finding
RELATION: SOURCE =&gt; includes =&gt; TARGET
&quot;The sepsis encompassed the period of atrial fibrillation.&quot;
SOURCE: &quot;sepsis&quot; =&gt; finding; TARGET: &quot;atrial fibrillation&quot; =&gt; finding
RELATION: SOURCE =&gt; includes =&gt; TARGET
&quot;The operation covered the transfusion.&quot;
SOURCE: &quot;operation&quot; =&gt; intervention; TARGET: &quot;transfusion&quot; =&gt; intervention
RELATION: SOURCE =&gt; includes =&gt; TARGET</obo:IAO_0000112>
        <obo:IAO_0000115>Statement indicating that a finding or intervention wholly contains the extent of another, sharing neither its beginning nor its end.</obo:IAO_0000115>
        <obo:IAO_0000232>Added 2026-10-30. TimeML TLINK relType INCLUDES; interval semantics are time:intervalContains, linked by rdfs:seeAlso. Annotated from a text cue between two events; the corresponding interval relation is derived from endpoints rather than annotated.</obo:IAO_0000232>
        <oboInOwl:id>CLCO:0000125</oboInOwl:id>
        <rdfs:label>includes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#intervalContains"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CLCO_0000126 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000126">
