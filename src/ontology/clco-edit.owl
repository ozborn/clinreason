    <!-- http://purl.obolibrary.org/obo/CLCO_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CLCO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CLCO_0000006"/>
        <rdfs:subClassOf>
